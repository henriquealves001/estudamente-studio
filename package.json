{
  "name": "estudamente-studio",
  "private": true,
  "version": "6.6.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-hosting.mjs && node scripts/run-framework.mjs dev",
    "build": "node scripts/ensure-hosting.mjs && tsc -b && tsc -p tsconfig.server.json && node scripts/run-framework.mjs build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types tests/all.test.ts",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "dev:legacy": "vite --config vite.legacy.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "json-rpc-2.0": "^1.7.1",
    "raw-body": "^3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vinext": "1.3.1",
    "vite": "^8.3.4",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5"
  }
}
