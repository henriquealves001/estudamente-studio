# Identificador PÚBLICO do cliente OAuth Web do seu aplicativo Google Cloud.
# Nenhum segredo deve ser colocado no frontend.
VITE_GOOGLE_CLIENT_ID=

# Autenticação própria: configurar também como variáveis do Worker (local: .dev.vars).
# Somente URL e chave pública. Nunca use service_role nem sb_secret aqui.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
