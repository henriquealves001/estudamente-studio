{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "@cloudflare/workers-types",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true
  },
  "include": [
    "app",
    "server",
    "db",
    "cloudflare-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
